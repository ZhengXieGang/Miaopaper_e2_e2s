# ============================================================
# 白名单式 .gitignore
#
# 默认忽略本目录下的一切，只放行关键文档、刷机 App 与两个
# 固件工程的源码。原厂 APK、反编译产物、flash dump、签名密钥、
# 构建产物、模拟器输出与第三方美术素材都不入库。
#
# 新增要入库的文件时，必须在对应目录下补一条 ! 放行规则。
# ============================================================

# ---------- 1. 默认全部忽略 ----------
*
!.gitignore

# Git 不能在被忽略的目录内部重新放行文件，
# 所以下面每个要放行的路径都逐级写了父目录规则。

# ---------- 2. 仓库根 ----------
!/.gitignore
!/LICENSE
!/README.md

# ---------- 3. 文档 ----------
!/docs/
!/docs/*.md
!/docs/images/
!/docs/images/*.png
!/docs/research/
!/docs/research/*.md

# ---------- 4. 刷机 App：app/E2SFlash ----------
!/app/
!/app/E2SFlash/
!/app/E2SFlash/.gitignore
!/app/E2SFlash/README.md
!/app/E2SFlash/settings.gradle
!/app/E2SFlash/build.gradle
!/app/E2SFlash/gradle.properties

!/app/E2SFlash/app/
!/app/E2SFlash/app/build.gradle
!/app/E2SFlash/app/proguard-rules.pro

!/app/E2SFlash/app/src/
!/app/E2SFlash/app/src/main/
!/app/E2SFlash/app/src/main/AndroidManifest.xml

!/app/E2SFlash/app/src/main/java/
!/app/E2SFlash/app/src/main/java/com/
!/app/E2SFlash/app/src/main/java/com/zxg/
!/app/E2SFlash/app/src/main/java/com/zxg/miaopaperflash/
!/app/E2SFlash/app/src/main/java/com/zxg/miaopaperflash/A5Flasher.java
!/app/E2SFlash/app/src/main/java/com/zxg/miaopaperflash/A5Protocol.java
!/app/E2SFlash/app/src/main/java/com/zxg/miaopaperflash/LockImageEditor.kt
!/app/E2SFlash/app/src/main/java/com/zxg/miaopaperflash/MainActivity.kt
!/app/E2SFlash/app/src/main/java/com/zxg/miaopaperflash/ReaderOtaFlasher.java
!/app/E2SFlash/app/src/main/java/com/zxg/miaopaperflash/ReaderTransfer.java
!/app/E2SFlash/app/src/main/java/com/zxg/miaopaperflash/TransferMedia.kt

!/app/E2SFlash/app/src/main/res/
!/app/E2SFlash/app/src/main/res/values/
!/app/E2SFlash/app/src/main/res/values/themes.xml
!/app/E2SFlash/app/src/main/res/values-night/
!/app/E2SFlash/app/src/main/res/values-night/themes.xml
!/app/E2SFlash/app/src/main/res/drawable/
!/app/E2SFlash/app/src/main/res/drawable/ic_launcher_background.xml
!/app/E2SFlash/app/src/main/res/drawable/ic_launcher_foreground.xml
!/app/E2SFlash/app/src/main/res/mipmap-anydpi-v26/
!/app/E2SFlash/app/src/main/res/mipmap-anydpi-v26/ic_launcher.xml
!/app/E2SFlash/app/src/main/res/mipmap-anydpi-v26/ic_launcher_round.xml

# App 的签名、本地配置与构建产物
/app/E2SFlash/keystore/
/app/E2SFlash/keystore.properties
/app/E2SFlash/local.properties
/app/E2SFlash/.gradle/
/app/E2SFlash/.kotlin/
/app/E2SFlash/build/
/app/E2SFlash/app/build/
/app/E2SFlash/app/src/main/assets/
/app/E2SFlash/app/src/main/assets-*/

